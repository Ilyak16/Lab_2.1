<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <x:Array x:Key="MyEditingModes" Type="InkCanvasEditingMode">
            <x:Static Member="InkCanvasEditingMode.Ink"/>
            <x:Static Member="InkCanvasEditingMode.Select"/>
            <x:Static Member="InkCanvasEditingMode.EraseByPoint"/>
            <x:Static Member="InkCanvasEditingMode.EraseByStroke"/>
        </x:Array>
        <x:Array x:Key="MyColor" Type="{x:Type DrawingAttributes}">
            <DrawingAttributes Color="Red"/>
            <DrawingAttributes Color="Blue"/>
            <DrawingAttributes Color="Green"/>
        </x:Array>
    </Window.Resources>
    <Grid x:Name="gr">
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="20"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition MaxHeight="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0" >
            <MenuItem Header="Взаимодействие" BorderBrush="Navy" BorderThickness="0" Height="20" Tag="0" MouseEnter="Button_MouseEnter">
                <MenuItem Header="Изменить фон">
                    <MenuItem Header="Желтый" Name="Yallow" Tag="1" Click="MenuItem_Click" MouseEnter="Button_MouseEnter"/>
                    <MenuItem Header="Красный" Name="Red" Tag="2" Click="MenuItem_Click" MouseEnter="Button_MouseEnter"/>
                    <MenuItem Header="Синий" Name="Blue" Tag="3" Click="MenuItem_Click" MouseEnter="Button_MouseEnter"/>
                </MenuItem>
                <MenuItem Header="О разработчике" Tag="4" Click="MenuItem_Click" MouseEnter="Button_MouseEnter"/>
            </MenuItem>
            <MenuItem Name="brushMenu" Header="Кисть" BorderBrush="Navy" BorderThickness="0" 
                <RadioButton GroupName="width_pen" Content="5" Checked="SizeRadioButton_Checked"/>
                <RadioButton GroupName="width_pen" Content="10" Checked="SizeRadioButton_Checked"/>
                <RadioButton GroupName="width_pen" Content="15" Checked="SizeRadioButton_Checked"/>
                <Separator/>
                <ListBox x:Name="lbClolors" ItemsSource="{StaticResource MyColor}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Color}"></TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Separator/>
                <ListBox x:Name="lbEditingMod" ItemsSource="{StaticResource MyEditingModes}">
                </ListBox>
                <MenuItem Header="Создать кисть" Tag="5" Click="MenuItem_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Информация:" />
            <StatusBarItem HorizontalAlignment="Right" Margin="0,0,10,0">
                <TextBlock Name="TextBlock_1" />
            </StatusBarItem>
        </StatusBar>
        <ToolBar Grid.Row="1" Grid.Column="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top"  >
            <Button MouseEnter="Button_MouseEnter" Tag="4" Click="MenuItem_Click">
                <Image Source="/man_13305169.png" Width="64" Height="64"></Image>
            </Button>
            <Button MouseEnter="Button_MouseEnter" Tag="3" Click="MenuItem_Click">
                <Image Source="/drop_17939275.png" Width="64" Height="64"></Image>
            </Button>
            <Button MouseEnter="Button_MouseEnter" Tag="2" Click="MenuItem_Click">
                <Image Source="/icons8-ведро-краски-50.png" Width="64" Height="64"></Image>
            </Button>
            <Button MouseEnter="Button_MouseEnter" Tag="1" Click="MenuItem_Click">
                <Image Source="/Yellow_5428816.png" Width="64" Height="64"></Image>
            </Button>
        </ToolBar>
        <InkCanvas Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" 
                   EditingMode="{Binding ElementName=lbEditingMod, Path=SelectedValue}" 
                   x:Name="Canv_1" 
                   DefaultDrawingAttributes="{Binding ElementName= lbClolors, Path=SelectedValue}">
        </InkCanvas>
    </Grid>
</Window>
