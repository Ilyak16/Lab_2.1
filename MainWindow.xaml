<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="gr" Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="20"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition MaxHeight="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="0">
            <MenuItem Header="Взаимодействие" BorderBrush="Navy" BorderThickness="0" Height="20">
                <MenuItem Header="Изменить фон">
                    <MenuItem Header="Желтый" Name="Yallow" Click="Yallow_Click"/>
                    <MenuItem Header="Красный" Name="Red" Click="Red_Click"/>
                    <MenuItem Header="Синий" Name="Blue" Click="Blue_Click"/>
                </MenuItem>
                <MenuItem Header="О разработчике"/>
            </MenuItem>
        </Menu>
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Информация:" />
            <StatusBarItem HorizontalAlignment="Right" >
                <TextBlock Name="TextBlock_1" />
            </StatusBarItem>
        </StatusBar>
        <ToolBar Grid.Row="1" Grid.Column="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top"  >
            <Button>
                <Image Source="/icons/man_13305169.png" Width="64"></Image>
            </Button>
            <Button>
                <Image Source="/icons/drop_17939275.png" Width="64"></Image>
            </Button>
            <Button>
                <Image Source="/icons/icons8-ведро-краски-50.png" Width="64"></Image>
            </Button>
            <Button>
                <Image Source="/icons/Yellow_5428816.png" Width="64"></Image>
            </Button>
        </ToolBar>
    </Grid>
</Window>
